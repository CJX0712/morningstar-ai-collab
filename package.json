{
  "name": "morningstar",
  "version": "1.0.0",
  "private": true,
  "description": "晨星 —— AI 原生团队协作平台（开源可自托管）. 作者：晨星",
  "author": "晨星",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:emoji": "node tools/scan-emoji.js",
    "e2e": "node scripts/e2e-check.js",
    "verify": "npm run build && npm run test && npm run e2e && npm run lint:emoji"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "5.9.3"
  }
}
