# 晨星 AI 原生团队协作平台 —— 环境变量样例
# 用法：cp .env.example .env ，按需修改。作者：晨星
# 所有服务均提供零依赖默认实现，不配置任何变量也能一键启动并跑通离线链路。

# ---------------------------------------------------------------------------
# 全局
# ---------------------------------------------------------------------------
NODE_ENV=production
# 前端调用后端的基址
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ---------------------------------------------------------------------------
# collab-core (3001) —— 协作核心
# ---------------------------------------------------------------------------
COLLAB_CORE_PORT=3001
# 仓储实现：memory（默认，进程内）/ postgres（预留，本期未实现）
STORAGE_BACKEND=memory
# 启用 postgres 时填写（可选）
# DATABASE_URL=postgres://morningstar:morningstar@postgres:5432/morningstar

# ---------------------------------------------------------------------------
# ai-gateway (3002) —— 统一 LLM / Agent 接入
# ---------------------------------------------------------------------------
AI_GATEWAY_PORT=3002
# provider：mock（默认，离线确定性）/ ollama（本地模型）/ openai（OpenAI 兼容端点）
LLM_PROVIDER=mock
LLM_MODEL=morningstar-mock-1
# 走 ollama 时：
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:7b
# 走云端 OpenAI 兼容端点时：
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# rag-service (3003) —— RAG 知识库
# ---------------------------------------------------------------------------
RAG_SERVICE_PORT=3003
# 向量后端：memory（默认，进程内余弦检索）/ qdrant
VECTOR_BACKEND=memory
# QDRANT_URL=http://qdrant:6333
# 嵌入器：hash（默认，离线确定性 256 维）/ remote
EMBEDDER=hash
# EMBEDDER=remote 时复用 ai-gateway：AI_GATEWAY_URL=http://ai-gateway:3002
EMBEDDING_DIM=256
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# meeting-summary (3004) —— 会议纪要
# ---------------------------------------------------------------------------
MEETING_SUMMARY_PORT=3004
# 不配置则走本地确定性兜底（离线可用）；配置后调用 ai-gateway
# AI_GATEWAY_URL=http://ai-gateway:3002
COLLAB_CORE_URL=http://collab-core:3001

# ---------------------------------------------------------------------------
# code-task-assistant (3005) —— 代码 / 任务助手
# ---------------------------------------------------------------------------
CODE_TASK_ASSISTANT_PORT=3005
# AI_GATEWAY_URL=http://ai-gateway:3002
# RAG_SERVICE_URL=http://rag-service:3003
# COLLAB_CORE_URL=http://collab-core:3001

# ---------------------------------------------------------------------------
# web (3000) —— 前端
# ---------------------------------------------------------------------------
WEB_PORT=3000
